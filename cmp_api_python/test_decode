def main():
    c = cmpapi_test.CmpApi()

    print("=== Per-jurisdiction strings ===\n")
    for name, gpp_string in TEST_STRINGS.items():
        print(f"--- {name} ---")
        print(f"string: {gpp_string}")
        try:
            result = cmpapi_test.decode(gpp_string, c)
            pprint.pprint(result)
        except Exception as e:
            print(f"DECODE FAILED: {e}")
        print()

    print("=== Combined string (all 24 sections) ===\n")
    print(f"string: {COMBINED_STRING}")
    try:
        result = cmpapi_test.decode(COMBINED_STRING, c)
        pprint.pprint(result)
    except Exception as e:
        print(f"DECODE FAILED: {e}")


if __name__ == "__main__":
    main()